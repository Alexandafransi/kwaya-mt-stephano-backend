# Rendered by Ansible — do not edit on the server, changes will be overwritten.
services:
  web:
    image: ${IMAGE}
    restart: unless-stopped
    env_file: .env
    # Loopback only, for the deploy health check; public traffic arrives
    # through Traefik on the proxy network.
    ports:
      - "127.0.0.1:8020:8000"
    volumes:
      # Uploaded song audio, gallery images and other media — must outlive
      # any image redeploy, so it is a named volume rather than image state.
      - kwaya_media:/app/media
    networks:
      - default
      - proxy
    labels:
      - traefik.enable=true
      - traefik.http.routers.kwaya-api.rule=Host(`{{ app_domain }}`)
      - traefik.http.routers.kwaya-api.entrypoints=websecure
      - traefik.http.routers.kwaya-api.tls.certresolver=letsencrypt
      - traefik.http.services.kwaya-api.loadbalancer.server.port=8000
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - kwaya_pgdata:/var/lib/postgresql/data
    networks:
      - default
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

networks:
  default:
  proxy:
    external: true

volumes:
  kwaya_pgdata:
  kwaya_media:
